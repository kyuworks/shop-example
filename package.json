{
  "name": "@kyuworks/shop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -b && vite build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --pretty false",
    "typecheck:tests": "tsc -b --pretty false tsconfig.test.json tsconfig.web.json",
    "test": "vitest run",
    "test:integration": "pnpm run build && vitest run --config vitest.integration.config.ts",
    "lint": "NODE_OPTIONS='--import tsx' oxlint",
    "migrate": "node dist/bin/migrate.js",
    "relay": "node dist/relay.js",
    "worker": "node dist/worker.js",
    "publish-cli": "node dist/bin/publish.js",
    "ui": "node dist/ui.js",
    "harness": "node dist/__tests__/harness/run.js",
    "harness:cancel-namespace": "node dist/__tests__/harness/cancelNamespaceCli.js",
    "web:dev": "vite",
    "web:build": "vite build",
    "format": "oxfmt --ignore-path .oxfmtignore \"**/*.{ts,tsx,mts,cts,css,json}\"",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore \"**/*.{ts,tsx,mts,cts,css,json}\"",
    "gates": "bash scripts/verify-gates.sh",
    "self-tests": "bash scripts/verify-self-tests.sh",
    "hatchet:up": "bash scripts/fetch-engine-compose.sh && docker compose -f .cache/kyu-engine/compose.yaml up -d --wait",
    "hatchet:down": "bash scripts/fetch-engine-compose.sh && docker compose -f .cache/kyu-engine/compose.yaml down"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@kyuworks/sdk": "^0.1.0",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.86.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0",
    "vite": "8.3.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0"
}
